---
import { Image } from 'astro:assets';
import { documents, photos, site, steps } from '../data/site';
import Icon from './Icon.astro';
---

<!-- „Ce fac în caz de deces?” (Memoris) ca pași lângă o poză reală. -->
<div class="grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
  <div>
    <ol class="space-y-4">
      {
        steps.map((s, i) => (
          <li class="reveal card flex gap-5 p-6">
            <span class="grid size-12 shrink-0 place-items-center rounded-full bg-ink-900 font-serif text-[24px] font-semibold text-gold-lt">
              {i + 1}
            </span>
            <div>
              <h3 class="text-[26px]">{s.title}</h3>
              <p class="mt-1.5">{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <a href={site.phoneHref} class="btn btn-gold btn-lg mt-6 max-sm:w-full">
      <Icon name="phone" size={20} />
      Sunați acum: {site.phone}
    </a>
  </div>

  <div class="flex flex-col gap-5">
    <figure class="reveal">
      <Image
        src={photos.dricBiserica2.img}
        alt={photos.dricBiserica2.alt}
        widths={[500, 800, 1100]}
        sizes="(min-width: 1024px) 520px, 100vw"
        class="ph aspect-[4/3] w-full object-cover object-[center_70%]"
      />
      <figcaption class="mt-2 text-[14px] text-muted">Mașina noastră, {site.legal.hearse}, la o înmormântare în Argeș.</figcaption>
    </figure>
    <div class="reveal rounded-[24px] bg-ink-900 p-7 text-on-dark">
      <h3 class="flex items-center gap-3 text-[26px] text-white">
        <Icon name="file" size={24} class="text-gold-lt" />
        Ce acte pregătiți
      </h3>
      <ul class="mt-4 space-y-3">
        {
          documents.map((d) => (
            <li class="flex gap-3">
              <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-gold/25 text-gold-lt">
                <Icon name="check" size={14} />
              </span>
              <span>{d}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-[15px] text-on-dark-muted">
        Restul, certificatul de deces și dosarul pentru ajutor, le facem împreună cu dumneavoastră.
      </p>
    </div>
  </div>
</div>
