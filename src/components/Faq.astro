---
import type { Qa } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  items: Qa[];
  title?: string;
  lead?: string;
}
const { items, title = 'Întrebări frecvente', lead = 'Dacă nu găsiți răspunsul, sunați-ne.' } = Astro.props;
---

<div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
  <div class="reveal">
    <h2>{title}</h2>
    <p class="lead mt-4 text-muted">{lead}</p>
  </div>
  <div class="space-y-3">
    {
      items.map((f, i) => (
        <details class="reveal group card px-6" open={i === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-[18px] font-semibold text-heading [&::-webkit-details-marker]:hidden">
            {f.q}
            <span class="grid size-9 shrink-0 place-items-center rounded-full bg-linen text-gold-dk transition-colors group-open:bg-ink-900 group-open:text-gold-lt">
              <Icon name="plus" size={16} class="group-open:hidden" />
              <Icon name="minus" size={16} class="hidden group-open:block" />
            </span>
          </summary>
          <p class="max-w-[640px] pb-6">{f.a}</p>
        </details>
      ))
    }
  </div>
</div>
