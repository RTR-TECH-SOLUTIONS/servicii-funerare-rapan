---
// Reluare vectorială a logo-ului de pe Facebook: scut negru cu cruce aurie + „RĂPAN”.
// TODO(real): dacă clientul are fișierul original al logo-ului, îl punem pe acela.
interface Props {
  tone?: 'light' | 'dark';
  class?: string;
}
const { tone = 'dark', class: cls = '' } = Astro.props;
const text = tone === 'dark' ? '#1d1915' : '#ffffff';
const sub = tone === 'dark' ? '#6a6057' : '#d8cdbd';
---

<span class={`inline-flex items-center gap-3 ${cls}`}>
  <svg width="38" height="44" viewBox="0 0 38 44" aria-hidden="true" class="shrink-0">
    <defs>
      <linearGradient id={`lg-${tone}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#efd893" />
        <stop offset="0.5" stop-color="#cfa544" />
        <stop offset="1" stop-color="#9a7a2c" />
      </linearGradient>
    </defs>
    <path d="M19 1.5 35.5 7v13.5C35.5 31 28 38.5 19 42.5 10 38.5 2.5 31 2.5 20.5V7z" fill="#14110e" stroke={`url(#lg-${tone})`} stroke-width="2" />
    <path d="M17.4 9h3.2v7.2h7v3.2h-7V34h-3.2V19.4h-7v-3.2h7z" fill={`url(#lg-${tone})`} />
  </svg>
  <span class="flex flex-col leading-none">
    <span class="font-serif text-[30px] font-semibold tracking-[0.04em]" style={`color:${text}`}>RĂPAN</span>
    <span class="mt-1 text-[11px] font-semibold tracking-[0.18em] uppercase" style={`color:${sub}`}>Servicii funerare</span>
  </span>
</span>
