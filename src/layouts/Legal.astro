---
import Layout from './Layout.astro';
import { u } from '../data/site';

interface Props {
  title: string;
  metaTitle: string;
  description: string;
  crumb: string;
  updated: string;
}

const { title, metaTitle, description, crumb, updated } = Astro.props;
---

<Layout title={metaTitle} description={description} noindex>
  <section class="px-3 pt-3">
    <div class="panel bg-ink-900 text-on-dark">
      <div class="wrap py-12 lg:py-16">
        <nav aria-label="Breadcrumb" class="text-[14px] text-on-dark-muted">
          <a href={u('/')} class="hover:text-gold-lt">Acasă</a>
          <span class="mx-2 text-gold" aria-hidden="true">·</span>
          <span aria-current="page" class="text-gold-lt">{crumb}</span>
        </nav>
        <h1 class="mt-4 text-white">{title}</h1>
        <p class="mt-4 text-[15px] text-on-dark-muted">Ultima actualizare: {updated}</p>
      </div>
    </div>
  </section>

  <section class="wrap py-14 lg:py-20">
    <div class="prose-legal max-w-[760px]">
      <slot />
    </div>
  </section>
</Layout>
