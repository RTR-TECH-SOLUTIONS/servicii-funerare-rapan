---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Zone from '../components/Zone.astro';
import Recenzii from '../components/Recenzii.astro';
import { photos, site } from '../data/site';

const gallery = [
  { ...photos.dricBiserica, caption: `Mercedes-ul mortuar, ${site.legal.hearse}, autorizat DSP Argeș.`, cls: 'md:col-span-2 aspect-[16/9]' },
  { ...photos.duba, caption: 'Duba pentru transportul sicriului și al coroanelor.', cls: 'aspect-[4/5] object-[center_70%]' },
  { ...photos.magazinZi, caption: 'Magazinul de pe drumul principal din Valea Ursului.', cls: 'aspect-[4/5]' },
  { ...photos.capela, caption: 'Capelă amenajată de noi, acasă la familie.', cls: 'aspect-[4/5]' },
  { ...photos.dricBiserica2, caption: 'La o înmormântare în Argeș.', cls: 'aspect-[4/5]' },
];
---

<Layout
  active="despre"
  title="Despre noi: firmă de familie din Valea Ursului, Bascov | Servicii Funerare Răpan"
  description="Servicii Funerare Răpan: firmă de familie din Valea Ursului, com. Bascov, cu mașină mortuară autorizată DSP, dubă și magazin propriu. 4,9 din 49 de recenzii pe Google."
>
  <PageHeader
    crumb="Despre noi"
    title="O firmă de familie din Valea Ursului"
    lead="Când sunați, vă răspunde domnul Neluțu Răpan, iar la înmormântare vin aceiași oameni cu care ați vorbit la telefon."
    photo={photos.magazin}
  />

  <section class="section">
    <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
      <div class="reveal space-y-4 lg:sticky lg:top-[calc(var(--header-h)+24px)] lg:self-start">
        <h2>Mașinile, magazinul și oamenii noștri</h2>
        <p>
          Lucrăm din Valea Ursului, comuna Bascov, pentru familiile din comună, din Pitești și din satele din jur. Suntem
          autorizați de DSP Argeș ca prestator de servicii funerare.
        </p>
        <p>
          Avem mașina mortuară și duba noastre, plus magazinul cu sicrie, cruci, coroane și tot ce trebuie. Gătim și pentru
          pomeni și parastase, așa că familia vorbește cu o singură firmă.
        </p>
        <dl class="grid grid-cols-2 gap-3 pt-4">
          <div class="card p-5">
            <dt class="text-[14px] text-muted">Recenzii pe Google</dt>
            <dd class="mt-1 font-serif text-[30px] leading-none font-semibold whitespace-nowrap sm:text-[36px]">{site.google.rating} din 5</dd>
            <dd class="mt-1 text-[14px] text-muted">{site.google.count} de recenzii</dd>
          </div>
          <div class="card p-5">
            <dt class="text-[14px] text-muted">Program</dt>
            <dd class="mt-1 font-serif text-[30px] leading-none font-semibold whitespace-nowrap sm:text-[36px]">Non-stop</dd>
            <dd class="mt-1 text-[14px] text-muted">7 zile din 7</dd>
          </div>
        </dl>
      </div>

      <div class="grid grid-cols-2 gap-3">
        {
          gallery.map((g) => (
            <figure class={`reveal ${g.cls.includes('col-span-2') ? 'col-span-2' : ''}`}>
              <Image
                src={g.img}
                alt={g.alt}
                widths={[400, 700, 1100]}
                sizes="(min-width: 1024px) 360px, 50vw"
                class={`ph w-full object-cover ${g.cls.replace('md:col-span-2', '')}`}
              />
              <figcaption class="mt-2 text-[14px] text-muted">{g.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section pt-0">
    <div class="wrap">
      <h2 class="reveal mb-8">Unde ajungem și în cât timp</h2>
      <Zone />
    </div>
  </section>

  <section class="section pt-0">
    <div class="wrap">
      <Recenzii />
    </div>
  </section>
</Layout>
