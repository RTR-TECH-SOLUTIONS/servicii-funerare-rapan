---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import PacheteCards from '../components/PacheteCards.astro';
import PachetContinut from '../components/PachetContinut.astro';
import Extras from '../components/Extras.astro';
import Faq from '../components/Faq.astro';
import { faqMoney, lei, packages, photos, site, u } from '../data/site';

const [p1, p2, p3] = packages.map((p) => lei(p.price));
---

<Layout
  active="pachete"
  title={`Pachete servicii funerare de la ${p1}, Bascov și Pitești | Răpan`}
  description={`Pachete funerare complete: ${p1}, ${p2} și ${p3}, cu sicriu, cruce, colive, prosoape, toaletizare, îmbălsămare, capac frigorific și transport gratuit. Intră în ajutorul de deces de ${lei(site.ajutor.asigurat)}.`}
>
  <PageHeader
    crumb="Pachete"
    title="Pachete și prețuri"
    lead="Prețul e spus de la început și nu se schimbă pe parcurs. Toate pachetele intră în ajutorul de deces pe care îl dă Casa de Pensii."
    photo={photos.duba}
    photoPos="center 68%"
  >
    <a slot="actions" href="#ce-contine" class="btn btn-ghost-dark btn-lg max-sm:w-full">Ce conține pachetul</a>
  </PageHeader>

  <section class="section">
    <div class="wrap">
      <PacheteCards />
    </div>
  </section>

  <PachetContinut />

  <section class="section">
    <div class="wrap">
      <Extras />
    </div>
  </section>

  <section class="section pt-0">
    <div class="wrap">
      <Faq items={faqMoney} title="Despre bani și ajutorul de deces" lead="Ce întreabă familiile înainte să aleagă un pachet." />
    </div>
  </section>
</Layout>
